# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# https://vercel.com/docs/postgres
# heads-up: every script in scripts/ and `pnpm build`'s pre-migrate step
# treat this URL as production. if you want a sandbox for local work,
# point .env.local at a separate Supabase project, not the prod one.
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# required for the bearer-authenticated agent API
# server-side pepper used to hash partner API keys at rest (32+ random bytes, base64).
# rotating this invalidates every partner key — reissue keys via `pnpm db:create-partner <name>`.
APP_PEPPER=****

# optional: stable secret pepper used to hash request IPs before storage
# (we persist only a one-way hash, never the raw IP). MUST stay constant or
# previously stored hashes stop matching new ones. Falls back to APP_PEPPER if unset.
IP_HASH_PEPPER=****

# required for study turns through the OpenAI Responses API.
# named STUDY_OPENAI_API_KEY (not OPENAI_API_KEY) so a global shell
# export of OPENAI_API_KEY won't override the project's key.
STUDY_OPENAI_API_KEY=****

# optional agent/study helpers
AGENT_API_BASE=http://localhost:3000
STUDY_MODEL=gpt-4o-mini

# OpenAI Stored Prompts — one per blinded study condition.
# The mapping from A/B/C to the descriptive label lives in
# docs/conditions-mapping.md (gitignored). Do NOT name these env vars after
# the real condition labels — keep blinding consistent across the stack.
# The pinned version is captured on AgentSession.promptVersion at session
# creation, so later edits to the stored prompt won't affect in-flight trials.
OPENAI_A_PROMPT_ID=pmpt_...
OPENAI_A_PROMPT_VERSION=3
OPENAI_B_PROMPT_ID=pmpt_...
OPENAI_B_PROMPT_VERSION=3
OPENAI_C_PROMPT_ID=pmpt_...
OPENAI_C_PROMPT_VERSION=3

# required if you generate or verify invitation tokens
INVITE_JWT_SECRET=****

# pre-launch testing toggle: when set to "1", invitation tokens are reusable
# — the redemption write and "already_redeemed" rejection are both skipped,
# so one minted token can start many interviews. Anti-forgery checks
# (signature, expiry, DB row existence) still run. Used so the research
# team can share a single link during dev.
# MUST be unset (or != "1") before real participants — see
# docs/goal.md pre-launch checklist.
PARTICIPANT_INVITATIONS_REUSABLE=

# staff/testing only: when "1", shows the unblinded condition label in the participant UI; must be unset for real participants
UNBLIND_FRONTEND=

# optional: where to send participants after they complete the interview
QUALTRICS_FOLLOWUP_URL=https://qualtrics.example.com/jfe/form/SV_xxxx
